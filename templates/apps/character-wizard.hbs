<div class="brp-wizard">
  <nav class="wiz-stepper">
    {{#each steps as |st|}}
      <button type="button" class="wiz-step-btn {{#if st.active}}active{{/if}}" data-action="goStep" data-step="{{st.num}}">
        {{st.label}}
      </button>
    {{/each}}
  </nav>

  <section class="wiz-body">
    {{#if isStep1}}
      <div class="panel-card wiz-section">
        <h3>{{#if isTh}}ขั้นที่ 1 ตามหนังสือ (หน้า 10): ชื่อ เพศ และคุณลักษณะ{{else}}Rulebook Step 1 (p.10): Name, Gender & Characteristics{{/if}}</h3>
        <div class="wiz-grid-2">
          <label class="field-box"><span>{{#if isTh}}ชื่อตัวละคร{{else}}Character Name{{/if}}</span><input type="text" data-wiz-field="name" value="{{wizardData.name}}" /></label>
          <label class="field-box"><span>{{#if isTh}}เพศ{{else}}Gender{{/if}}</span><input type="text" data-wiz-field="gender" value="{{wizardData.gender}}" /></label>
          <label class="field-box"><span>{{#if isTh}}ชื่อผู้เล่น{{else}}Player{{/if}}</span><input type="text" data-wiz-field="playerName" value="{{wizardData.playerName}}" /></label>
          <label class="field-box"><span>{{#if isTh}}วัฒนธรรม{{else}}Culture{{/if}}</span><input type="text" data-wiz-field="culture" value="{{wizardData.culture}}" /></label>
        </div>
        <p class="meta-text">{{#if isTh}}เลือกวิธีสร้างค่าสถานะก่อน แล้วกดปุ่มทอยด้วยตนเอง (ไม่มีการทอยอัตโนมัติเมื่อเปิด Wizard){{else}}Choose a characteristic generation method, then roll manually. Opening the Wizard never rolls dice.{{/if}}</p>
      </div>
      <div class="panel-card wiz-section">
        <div class="panel-header">
          <h3>{{#if isTh}}กำหนดค่าสถานะหลัก (Characteristics){{else}}Determine Characteristics{{/if}}</h3>
          <div class="toolbar-btns">
            <select data-wiz-method>
              <option value="rolled" {{#if (eq wizardData.method "rolled")}}selected{{/if}}>Standard Roll (3D6 / 2D6+6)</option>
              <option value="heroic_roll" {{#if (eq wizardData.method "heroic_roll")}}selected{{/if}}>Higher Starting Characteristics (2D6+6)</option>
              <option value="point_buy" {{#if (eq wizardData.method "point_buy")}}selected{{/if}}>Point-Buy ({{pointBuyTotal}} แต้ม)</option>
            </select>
            {{#unless isPointBuy}}
              <button type="button" class="brp-btn primary" data-action="rollAllChars">
                {{#if isTh}}ทอยใหม่ทั้งหมด (Roll All){{else}}Roll All{{/if}}
              </button>
            {{/unless}}
          </div>
        </div>

        {{#if isPointBuy}}
          <div class="wiz-budget-bar">
            <span>แต้ม Point-Buy ที่ใช้: <strong>{{pointBuyUsed}} / {{pointBuyTotal}}</strong></span>
            <span>คงเหลือ: <strong class="{{#if (eq pointBuyRemaining 0)}}ok{{else}}accent{{/if}}">{{pointBuyRemaining}}</strong></span>
          </div>
        {{/if}}

        {{#unless isPointBuy}}<p class="meta-text">{{#if isTh}}กฎหลัก: หลังทอยค่าสถานะ สามารถย้ายแต้มได้ไม่เกิน 3 แต้ม (ผลรวมต้องเท่าเดิม) — ย้ายแล้ว {{rolledRedistribution.moved}}/3{{else}}Core rule: move up to 3 points between rolled characteristics without changing the sum — moved {{rolledRedistribution.moved}}/3{{/if}}</p>{{/unless}}
        <div class="wiz-chars-grid">
          {{#each characteristics as |c|}}
            <div class="char-box">
              <span class="char-key">{{c.short}} <small>({{c.formula}})</small></span>
              <div class="step-group">
                <button type="button" class="step-btn" data-action="stepChar" data-char="{{c.key}}" data-delta="-1">−</button>
                <input type="number" data-wiz-char="{{c.key}}" value="{{c.value}}" />
                <button type="button" class="step-btn" data-action="stepChar" data-char="{{c.key}}" data-delta="1">+</button>
              </div>
              <div class="wiz-char-sub">
                <span>{{c.rollPct}}%{{#unless (eq c.effective c.value)}} · {{#if @root.isTh}}ปรับตามอายุ{{else}}Age adjusted{{/if}}: {{c.effective}}{{/unless}}</span>
                {{#unless @root.isPointBuy}}
                  <button type="button" class="icon-btn" data-action="rollSingleChar" data-char="{{c.key}}" title="ทอยใหม่"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i></button>
                {{/unless}}
              </div>
            </div>
          {{/each}}
        </div>

        <div class="wiz-derived-preview">
          <span>HP: <strong>{{derivedPreview.maxHp}}</strong> (MW ≥ {{derivedPreview.majorWound}})</span>
          <span>PP: <strong>{{derivedPreview.maxPp}}</strong></span>
          <span>FP: <strong>{{derivedPreview.maxFp}}</strong></span>
          <span>SAN: <strong>{{derivedPreview.san}}</strong></span>
          <span>DM: <strong>{{derivedPreview.dm}}</strong></span>
        </div>
      </div>
    {{/if}}
    {{#if isStep2}}
      <div class="panel-card wiz-section">
        <h3 data-tooltip="{{#if isTh}}แสดงเฉพาะระบบพลังที่ GM เปิดใช้{{else}}Only power families enabled by the GM appear here{{/if}}">{{#if isTh}}พลังพิเศษ{{else}}Powers{{/if}}</h3>
        {{#unless powerSystemsAvailable}}
          <p class="meta-text wiz-contrast-note">{{#if isTh}}แคมเปญนี้ไม่ได้เปิดใช้ระบบพลัง สามารถข้ามขั้นตอนนี้ได้{{else}}No power systems are enabled in this campaign. Skip this step.{{/if}}</p>
        {{else}}
          <p class="meta-text wiz-contrast-note">{{#if isTh}}เลือกหมวดและอ่านรายละเอียดก่อนเพิ่มพลังลงตัวละคร{{else}}Choose a family and inspect each power before adding it.{{/if}}</p>
        {{/unless}}
      </div>
      {{#if powerSystemsAvailable}}
      <div class="panel-card wiz-section">
        <div class="wiz-power-board" data-wiz-drop-item="power">
          <div class="panel-header"><h3>{{#if isTh}}เลือกพลัง{{else}}Choose Powers{{/if}}</h3></div>
          <div class="wiz-power-filters">
            <label class="field-box"><span>{{#if isTh}}ประเภทพลัง{{else}}Power family{{/if}}</span>
              <select data-wiz-power-filter data-tooltip="{{#if isTh}}กรองตามประเภทพลังที่ GM อนุญาต{{else}}Filter by enabled power family{{/if}}">
                <option value="all" {{#if powerFilterAll}}selected{{/if}}>{{#if isTh}}ทั้งหมด{{else}}All enabled families{{/if}}</option>
                {{#each powerSystemGroups as |group|}}<option value="{{group.id}}" {{#if group.selected}}selected{{/if}}>{{group.label}} ({{group.count}})</option>{{/each}}
              </select>
            </label>
            <label class="field-box"><span>{{#if isTh}}รายการพลัง{{else}}Power{{/if}}</span>
              <select data-wiz-power-select data-tooltip="{{#if isTh}}เลือกรายการเพื่ออ่านคำอธิบายก่อนเพิ่ม{{else}}Select a power to read details first{{/if}}">
                <option value="">{{#if isTh}}— เลือกเพื่อดูรายละเอียด —{{else}}— Select to inspect —{{/if}}</option>
                {{#each powerCatalog as |pow|}}<option value="{{pow.index}}" {{#if pow.previewSelected}}selected{{/if}}>{{pow.name}}{{#if @root.isTh}} · {{pow.english}}{{/if}} ({{pow.type}}){{#if pow.selected}} ✓{{/if}}</option>{{/each}}
              </select>
            </label>
            <button type="button" class="brp-btn primary" data-action="addWizardPower" data-tooltip="{{#if isTh}}เพิ่มพลังที่กำลังอ่านอยู่ หากยังไม่เคยเลือก{{else}}Add selected power once{{/if}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{#if isTh}}เพิ่มพลัง{{else}}Add Power{{/if}}</button>
          </div>
          {{#unless powerCatalog.length}}<p class="meta-text wiz-contrast-note">{{#if isTh}}ไม่มีพลังในหมวดนี้จากคลังที่ติดตั้ง{{else}}No powers in this family from installed sources{{/if}}</p>{{/unless}}
          {{#if powerPreview}}
            <div class="wiz-rule-preview" role="region" aria-label="Power rules">
              <strong>{{powerPreview.name}}</strong><small lang="en">{{powerPreview.nameEn}} · {{powerPreview.system}}</small>
              <div class="wiz-rule-copy">{{powerPreview.description}}</div>
            </div>
          {{/if}}
          <div class="panel-header"><h3>{{#if isTh}}รายการพลังของตัวละคร{{else}}Character Powers{{/if}} ({{powerCount}})</h3></div>
          <div class="wiz-power-selected-list">
          {{#each powerRows as |power|}}
            <div class="wiz-picked-row">
              <div class="wiz-picked-heading">
                <button class="wiz-power-open" type="button" data-action="viewWizardPower" data-index="{{power.index}}" data-tooltip="{{#if @root.isTh}}คลิกอ่านความสามารถ{{else}}Read full power description{{/if}}"><strong>{{power.name}}</strong><small lang="en">{{power.nameEn}} · {{power.type}}</small></button>
                <button type="button" class="icon-btn danger" data-action="removeWizardPower" data-index="{{power.index}}" title="{{#if @root.isTh}}ลบพลัง{{else}}Remove power{{/if}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
              </div>
              {{#if power.allocated}}
              <div class="wiz-power-allocation">
                <span>{{#if @root.isTh}}อาชีพ{{else}}Occupation{{/if}}</span>
                <button type="button" class="step-btn" data-action="allocatePower" data-index="{{power.index}}" data-pool="occ" data-delta="-5">−5</button>
                <strong>{{power.occPts}}</strong><button type="button" class="step-btn" data-action="allocatePower" data-index="{{power.index}}" data-pool="occ" data-delta="5">+5</button>
                <span>{{#if @root.isTh}}ส่วนตัว{{else}}Personal{{/if}}</span>
                <button type="button" class="step-btn" data-action="allocatePower" data-index="{{power.index}}" data-pool="pers" data-delta="-5">−5</button><strong>{{power.persPts}}</strong>
                <button type="button" class="step-btn" data-action="allocatePower" data-index="{{power.index}}" data-pool="pers" data-delta="5">+5</button>
                <strong>{{power.total}}%</strong>
              </div>
              {{/if}}
              <details class="wiz-picked-details"><summary>{{#if @root.isTh}}อ่านรายละเอียดความสามารถ{{else}}Power details{{/if}}</summary><div class="wiz-rule-copy">{{power.description}}</div></details>
            </div>
          {{else}}<p class="empty-hint">{{#if isTh}}ยังไม่ได้เลือกพลัง{{else}}No powers selected{{/if}}</p>{{/each}}
          </div>
        </div>
      </div>
      {{/if}}
    {{/if}}
    {{#if isStep3}}
      <div class="panel-card wiz-section">
        <h3>{{#if isTh}}อายุและบุคลิก{{else}}Age & Personality{{/if}}</h3>
        <div class="wiz-grid-2">
          <div class="field-box"><span>{{#if isTh}}อายุเริ่มต้น (ทอย 17+1D6){{else}}Starting Age (roll 17+1D6){{/if}}</span><button type="button" class="brp-btn" data-action="rollAge" {{#unless isGM}}{{#unless ageRequiresRoll}}disabled{{/unless}}{{/unless}} title="{{#if isTh}}ทอยอายุด้วยตัวเอง GM สามารถอนุญาตให้ทอยใหม่ได้{{else}}Roll starting age; GM may authorize rerolls{{/if}}"><i class="fa-solid fa-dice" aria-hidden="true"></i> {{#if ageRule.reference}}{{ageRule.reference}}{{else}}{{#if isTh}}ทอยอายุ{{else}}Roll age{{/if}}{{/if}}</button></div>
          <label class="field-box"><span>{{#if isTh}}อายุตัวละครปัจจุบัน{{else}}Current age{{/if}}</span><input type="number" min="0" data-wiz-field="age" value="{{wizardData.age}}" {{#unless isGM}}readonly{{/unless}} title="{{#if isTh}}GM กำหนดอายุต่างจากค่าเริ่มต้นได้เพื่อใช้กฎอายุ{{else}}Only GM can approve an age different from the starting roll{{/if}}" /></label>
          {{#if ageHasAging}}<label class="field-box"><span>{{#if isTh}}ลำดับลดค่าสถานะตามอายุ{{else}}Aging characteristic order{{/if}}</span><select data-wiz-aging-priority {{#unless isGM}}disabled{{/unless}}>{{#each agingPriorityChoices as |v|}}<option value="{{v.key}}" {{#if v.selected}}selected{{/if}}>{{v.label}}</option>{{/each}}</select></label>{{/if}}
          {{#if ageHasYouth}}<label class="field-box"><span>{{#if isTh}}ค่าสถานะที่ลดเนื่องจากอายุน้อยกว่าอายุฐาน{{else}}Youth characteristic reduction{{/if}}</span><select data-wiz-youth-stat {{#unless isGM}}disabled{{/unless}}>{{#each youthCharacteristicChoices as |v|}}<option value="{{v.key}}" {{#if v.selected}}selected{{/if}}>{{v.label}}</option>{{/each}}</select></label>{{/if}}
        </div>
        <div class="wiz-rules-summary wiz-contrast-note" role="status">{{#if isTh}}แต้มอาชีพปรับตามอายุ{{else}}Age-adjusted occupation points{{/if}}: <strong>{{ageRule.occupationDelta}}</strong> · EDU: <strong>+{{ageRule.eduBonus}}</strong> · {{#if isTh}}ค่าสถานะปรับตามอายุ{{else}}Characteristic aging changes{{/if}}: <strong>{{#if ageCharacteristicDeltas}}{{ageCharacteristicDeltas}}{{else}}—{{/if}}</strong></div>
        <h3>{{#if isTh}}การทอยคุณลักษณะ{{else}}Step 4: Characteristic Rolls{{/if}}</h3>
        <div class="wiz-derived-preview">{{#each characteristics as |c|}}<span>{{c.short}}: <strong>{{c.rollPct}}%</strong></span>{{/each}}</div>
        <h3>{{#if isTh}}ค่าคำนวณจากคุณลักษณะ{{else}}Step 5: Derived Characteristics{{/if}}</h3>
        <div class="wiz-derived-preview">
          <span>HP: <strong>{{derivedPreview.maxHp}}</strong></span><span>PP: <strong>{{derivedPreview.maxPp}}</strong></span>
          <span>FP: <strong>{{derivedPreview.maxFp}}</strong></span><span>SAN: <strong>{{derivedPreview.san}}</strong></span>
          <span>DM: <strong>{{derivedPreview.dm}}</strong></span>
        </div>
        <h3>{{#if isTh}}บุคลิก{{else}}Personality{{/if}}</h3>
        <div class="wiz-personality-config"><label>{{#if isTh}}รูปแบบบุคลิก{{else}}Personality package{{/if}}</label>
          <select data-wiz-personality>{{#each personalityChoices as |p|}}<option value="{{p.key}}" {{#if p.selected}}selected{{/if}}>{{p.label}}</option>{{/each}}</select>
          <p class="meta-text">{{#if isTh}}ตัวเลือกเริ่มต้นเป็นคำแนะนำสำหรับทักษะประเภท “any”; เลือกแก้รายทักษะได้ ไม่เปลี่ยนบุคลิกอัตโนมัติ{{else}}Presets suggest choices for “any” skills; manually review the 13 selected references{{/if}}</p>
          <div class="brp-ref-picker"><select data-wiz-personality-select><option value="">{{#if isTh}}เลือกทักษะจากคลัง{{else}}Choose Skill{{/if}}</option>{{#each personalityAvailable as |o|}}<option value="{{o.index}}">{{o.label}}</option>{{/each}}</select>
            <button type="button" class="brp-btn" data-action="addPersonalitySkill">+ 20%</button></div>
          <div class="wiz-picked-list">{{#each personalitySelected as |o|}}<div class="wiz-picked-row"><div class="wiz-picked-heading"><strong>{{o.label}}</strong><button type="button" class="icon-btn danger" data-action="removePersonalitySkill" data-index="{{o.index}}" title="{{#if @root.isTh}}ลบทักษะ{{else}}Remove skill{{/if}}">×</button></div></div>{{/each}}</div>
          <strong>{{personalityCount}} / {{#if (eq wizardData.personalityType "none")}}0{{else}}13{{/if}} {{#if isTh}}ทักษะ{{else}}skills{{/if}}</strong>
        </div>
      </div>
    {{/if}}
    {{#if isStep4}}
      <div class="brp-wiz-step4-progress" role="status">
        <span class="{{#if selectedProfession.sourceUuid}}is-complete{{/if}}"><b>1</b> {{#if isTh}}เลือกอาชีพ{{else}}Choose occupation{{/if}}</span>
        <span class="{{#if occupationChoicesValid}}is-complete{{/if}}"><b>2</b> {{#if isTh}}เลือกทักษะและ Specialty{{else}}Resolve Skill choices{{/if}}</span>
        <span><b>3</b> {{#if isTh}}แจกแต้มอาชีพและแต้มส่วนตัว{{else}}Allocate occupation/personal points{{/if}}</span>
      </div>
      <div class="panel-card wiz-section">
        <h3>{{#if isTh}}เลือกอาชีพและจัดสรรทักษะ{{else}}Occupation & Skills{{/if}}</h3>
        <div class="wiz-drop-hint" data-wiz-drop-item="occupation">{{#if isTh}}ลาก Occupation Item จาก Items Directory / Compendium มาวางที่นี่ได้{{else}}Drop an Occupation Item here from Items Directory / Compendium{{/if}}</div>
        <div class="wiz-occupation-layout">
          <div class="wiz-occupation-catalog" role="group" aria-label="{{#if isTh}}รายการอาชีพ{{else}}Occupation catalog{{/if}}">
            <label class="wiz-occupation-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-wiz-prof-search value="{{professionFilter}}" autocomplete="off" dir="auto" placeholder="{{#if isTh}}ค้นหาอาชีพ...{{else}}Search occupations...{{/if}}" aria-label="{{#if isTh}}ค้นหาอาชีพ{{else}}Search occupations{{/if}}"></label>
            <div class="wiz-occupation-list">
              <button type="button" class="wiz-occupation-row {{#unless selectedProfession.sourceUuid}}selected{{/unless}}" data-action="selectProfession" data-prof-id="" data-search="{{#if isTh}}ไม่เลือกอาชีพ{{else}}no occupation{{/if}}" aria-pressed="{{#unless selectedProfession.sourceUuid}}true{{else}}false{{/unless}}">
                <i class="fa-regular fa-circle-xmark" aria-hidden="true"></i><span class="wiz-occupation-label">{{#if isTh}}ยังไม่เลือกอาชีพ{{else}}No occupation{{/if}}</span><span class="wiz-occupation-action">{{#unless selectedProfession.sourceUuid}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{/unless}}</span>
              </button>
              {{#each professions as |p|}}
                <button type="button" class="wiz-occupation-row {{#if p.selected}}selected{{/if}}" data-action="selectProfession" data-prof-id="{{p.id}}" data-search="{{p.searchText}}" title="{{p.titleEn}}" aria-pressed="{{#if p.selected}}true{{else}}false{{/if}}">
                  <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                  <span class="wiz-occupation-label">{{p.title}}</span>
                  {{#if p.wealthLabel}}<small class="wiz-occupation-wealth">{{p.wealthLabel}}</small>{{/if}}
                  <span class="wiz-occupation-action">{{#if p.selected}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{else}}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>{{/if}}</span>
                </button>
              {{/each}}
              {{#unless professions.length}}<p class="meta-text">{{#if isTh}}ยังไม่มี Occupation Items ในคลังที่ติดตั้ง{{else}}No Occupation Items from installed sources{{/if}}</p>{{/unless}}
            </div>
          </div>
          <section class="wiz-occupation-preview" aria-live="polite">
            {{#if selectedProfession.sourceUuid}}
              <div class="wiz-occupation-preview-header"><i class="fa-solid fa-briefcase" aria-hidden="true"></i><h4>{{selectedProfession.title}}</h4></div>
              {{#if isTh}}{{#if selectedProfession.titleEn}}<small lang="en">{{selectedProfession.titleEn}}</small>{{/if}}{{/if}}
              <div class="wiz-occupation-preview-meta">{{#if isTh}}ทักษะอ้างอิง{{else}}Linked skill references{{/if}}: {{professionLinkedSkillCount}} {{#if professionMissingSkillCount}}· {{#if isTh}}ขาด{{else}}Missing{{/if}}: {{professionMissingSkillCount}}{{/if}}</div>
              {{#if professionFixedSkillNames.length}}
                <div class="brp-wiz-fixed-skills"><strong>{{#if isTh}}ทักษะที่อาชีพกำหนด{{else}}Required occupational Skills{{/if}}</strong>
                  <div class="brp-wiz-choice-chips">{{#each professionFixedSkillNames as |name|}}<span class="brp-wiz-choice-chip">{{name}}</span>{{/each}}</div>
                </div>
              {{/if}}
              <div class="wiz-occupation-preview-rule">{{selectedProfession.sub}}</div>
            {{else}}
              <p class="meta-text">{{#if isTh}}เลือกอาชีพจากรายการด้านซ้ายเพื่ออ่านคำอธิบาย หรือสร้างตัวละครโดยยังไม่กำหนดอาชีพ{{else}}Choose an occupation to inspect its rules, or proceed without one{{/if}}</p>
            {{/if}}
          </section>
        </div>
      </div>
      {{#if occupationMetadataMissing}}
      <div class="panel-card wiz-occupation-setup-warning" role="alert">
        <strong><i class="fa-solid fa-triangle-exclamation"></i> {{#if isTh}}อาชีพนี้ยังไม่ได้กำหนดเงื่อนไขการเลือกทักษะ{{else}}Occupation choice rules are not configured{{/if}}</strong>
        <p>{{#if isTh}}คำอธิบายอาชีพมีเงื่อนไขให้เลือกทักษะ แต่ Compendium ยังไม่มี Choice Groups ที่ Wizard ใช้อ่านได้ กรุณาให้ GM ตั้งค่าก่อน เพื่อไม่ให้เสียสิทธิ์เลือกทักษะตามกฎ{{else}}The occupation description mentions choices, but its Compendium Item has no structured Choice Groups. Ask the GM to configure them so all choices are honored.{{/if}}</p>
        {{#if isGM}}<button type="button" class="brp-btn" data-action="openOccupationChoiceSetup"><i class="fa-solid fa-gear"></i> {{#if isTh}}เปิดอาชีพเพื่อกำหนดทางเลือก{{else}}Configure this Occupation{{/if}}</button>{{/if}}
      </div>
      {{/if}}
      {{#if professionChoiceGroups.length}}
      <div class="panel-card wiz-section brp-wiz-occupation-choices">
        <h3>{{#if isTh}}เลือกทักษะและ Specialty ของอาชีพก่อนแบ่งแต้ม{{else}}Resolve Occupation Skill Choices before allocating points{{/if}}</h3>
        <p class="meta-text">{{#if isTh}}เลือกทักษะตามจำนวนและเงื่อนไขที่ GM กำหนดไว้ใน Occupation Item; การเลือกยังไม่ใช้แต้ม{{else}}Select each required skill from the Occupation's authorized list; selecting a Specialty costs no points.{{/if}}</p>
        {{#each professionChoiceGroups as |g|}}
          <section class="brp-wiz-choice-group">
            <header>
              <strong>{{g.label}}</strong>
              <span class="{{#if g.complete}}is-complete{{else}}is-pending{{/if}}">{{g.selectedCount}} / {{g.count}}</span>
            </header>
            <div class="brp-wiz-choice-picker">
              <label class="brp-wiz-choice-field">
                <span>{{#if @root.isTh}}1. เลือกทักษะ{{else}}1. Choose Skill{{/if}}</span>
                <select data-occupation-skill-picker="{{g.id}}" aria-label="{{g.label}}">
                  <option value="">{{#if @root.isTh}}เลือกทักษะ / Skill Family…{{else}}Choose a Skill Family…{{/if}}</option>
                  {{#each g.pickerChoices as |c|}}
                    <option value="{{c.value}}">{{c.label}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="brp-wiz-choice-field">
                <span>{{#if @root.isTh}}2. เลือก Specialty{{else}}2. Choose Specialty{{/if}}</span>
                <select data-occupation-specialty-picker="{{g.id}}" aria-label="Specialty" disabled hidden></select>
              </label>
              <button type="button" class="brp-btn" data-action="selectOccupationChoice" data-group-id="{{g.id}}">
                <i class="fa-solid fa-check"></i> {{#if @root.isTh}}ยืนยันตัวเลือก{{else}}Add chosen Skill{{/if}}
              </button>
            </div>
            {{#if g.selected.length}}
              <div class="brp-wiz-choice-chips">
                {{#each g.selected as |c|}}
                  <span class="brp-wiz-choice-chip">{{c.label}}
                    <button type="button" data-action="removeOccupationChoice" data-group-id="{{g.id}}" data-key="{{c.key}}" aria-label="{{#if @root.isTh}}นำทางเลือกออก{{else}}Remove choice{{/if}}">×</button>
                  </span>
                {{/each}}
              </div>
            {{/if}}
            {{#unless g.candidates.length}}
              <p class="brp-wiz-choice-warning">{{#if @root.isTh}}ไม่พบตัวเลือกที่ตรงกับเงื่อนไข กรุณาให้ GM ตรวจสอบ Compendium และ Occupation{{else}}No compatible options: ask the GM to review this Occupation and its content packs.{{/if}}</p>
            {{/unless}}
          </section>
        {{/each}}
        {{#unless occupationChoicesValid}}<p class="brp-wiz-choice-warning" role="status">{{#if isTh}}เลือกทักษะอาชีพให้ครบทุกกลุ่มก่อนจัดสรรแต้มอาชีพ{{else}}Complete every choice group before spending occupation points.{{/if}}</p>{{/unless}}
      </div>
      {{/if}}
      <div class="panel-card wiz-section">
        <div class="wiz-budget-bar">
          <span>{{#if isTh}}อาชีพ{{else}}Occupation{{/if}} <strong>{{selectedProfession.title}}</strong></span>
          <span data-tooltip="{{#if isTh}}วิธีคำนวณที่ GM เลือกใน Game Settings{{else}}GM-selected budget method{{/if}}">{{occupationBudgetLabel}}</span>
          <span class="wiz-budget-pill"><i class="fa-solid fa-briefcase"></i> {{#if isTh}}แต้มอาชีพคงเหลือ{{else}}Occupation remaining{{/if}}: <strong class="accent">{{occRemaining}} pt</strong> / {{occBudget}}</span>
          <span class="wiz-budget-pill"><i class="fa-solid fa-user"></i> {{#if isTh}}แต้มส่วนตัวคงเหลือ{{else}}Personal remaining{{/if}}: <strong class="accent">{{persRemaining}} pt</strong> / {{persBudget}}</span>
          <span>{{#if isTh}}เพดานที่ GM ตั้ง{{else}}GM cap{{/if}}: <strong>{{rules.creationSkillCap}}%</strong></span>
        </div>

        {{#if selectedProfession.sourceUuid}}
          <p class="wiz-linked-skills-note" role="status">
            {{#if isTh}}ทักษะอาชีพที่เชื่อมโยงแล้ว: <strong>{{professionLinkedSkillCount}}</strong> รายการ — จะถูกเพิ่มลงชีทพร้อมค่าเริ่มต้น แม้ยังไม่แบ่งแต้ม ตัวเลือกทักษะเพิ่มเติมจะแสดงแยกตามกลุ่มด้านบน{{else}}Linked occupation skills: <strong>{{professionLinkedSkillCount}}</strong>. These will be added to the sheet at their base chance even without allocated points. Complete any choice groups above before spending occupation points.{{/if}}
            {{#if professionMissingSkillCount}}<strong class="wiz-link-warning">{{#if isTh}}ไม่พบลิงก์ทักษะ {{professionMissingSkillCount}} รายการ — ตรวจ Skills Compendium และเปิด Wizard ใหม่{{else}}Missing {{professionMissingSkillCount}} skill links — check the Skills Compendium and reopen the Wizard{{/if}}</strong>{{/if}}
          </p>
        {{/if}}
        {{#if personalFamilyOptions.length}}
          <section class="brp-wiz-personal-specialty">
            <strong>{{#if isTh}}เลือก Specialty เพิ่มสำหรับแต้มส่วนตัว{{else}}Add a Specialty for Personal Points{{/if}}</strong>
            <p class="meta-text">{{#if isTh}}เลือก Skill Family ก่อน จากนั้นเลือก Specialty ที่ GM เปิดใช้ การเลือกยังไม่ใช้แต้ม และไม่ได้ให้สิทธิ์ใช้แต้มอาชีพ{{else}}Choose the Skill Family first, then its GM-approved Specialty. This does not spend points or grant occupation eligibility.{{/if}}</p>
            <div class="brp-wiz-choice-picker">
              <label class="brp-wiz-choice-field"><span>{{#if isTh}}ทักษะ{{else}}Skill Family{{/if}}</span>
                <select data-personal-family-picker aria-label="Personal Skill Family">
                  <option value="">{{#if isTh}}เลือกทักษะ…{{else}}Select Skill…{{/if}}</option>
                  {{#each personalFamilyOptions as |f|}}<option value="{{f.key}}">{{f.label}}</option>{{/each}}
                </select></label>
              <label class="brp-wiz-choice-field"><span>Specialty</span>
                <select data-personal-specialty-picker aria-label="Personal Specialty" disabled hidden></select></label>
              <button type="button" class="brp-btn" data-action="addPersonalSpecialty"><i class="fa-solid fa-plus"></i> {{#if isTh}}เพิ่มทักษะ{{else}}Add Skill{{/if}}</button>
            </div>
          </section>
        {{/if}}
        <div class="wiz-drop-hint" data-wiz-drop-item="skill">{{#if isTh}}ลาก Skill Item จากคลังมาวางเพื่อเพิ่มทักษะในรายการแบ่งแต้ม{{else}}Drop Skill Items to add custom skills to allocation{{/if}}</div>
        <div class="wiz-search-row">
          <input type="search" dir="auto" autocomplete="off" data-wiz-skill-search value="{{wizardData.skillFilter}}" placeholder="{{#if isTh}}ค้นหาทักษะ...{{else}}Filter skills...{{/if}}" />
        </div>
        <p class="brp-wiz-allocation-guidance">{{#if isTh}}<strong>วิธีจัดสรรแต้ม:</strong> ทักษะอาชีพที่เลือกไว้จะมีป้าย “อาชีพ” และใช้แต้มจากช่องอาชีพได้ ส่วนทักษะอื่นใช้แต้มส่วนตัวตามกฎ หากยังไม่เห็นทักษะที่ต้องการ ให้เลือก Family และ Specialty ด้านบนก่อน{{else}}<strong>How to allocate:</strong> Occupation-tagged skills can receive professional points; other permitted skills use personal points. Add a Skill Family and Specialty above if you do not see the one you need.{{/if}}</p>
        <div class="wiz-skill-header" aria-hidden="true">
          <span>{{#if isTh}}ทักษะ / พื้นฐาน{{else}}Skill / Base{{/if}}</span>
          <span data-tooltip="{{#if isTh}}แต้มทักษะจากอาชีพ{{else}}Occupation allocation{{/if}}">{{#if isTh}}อาชีพ{{else}}Occupation{{/if}}</span>
          <span data-tooltip="{{#if isTh}}แต้มทักษะจากความสนใจและประสบการณ์ส่วนตัว{{else}}Personal allocation{{/if}}">{{#if isTh}}ส่วนตัว{{else}}Personal{{/if}}</span>
          <span>{{#if isTh}}รวม{{else}}Total{{/if}}</span>
        </div>

        {{#unless skillRows.length}}<p class="meta-text wiz-error-notice">{{#if isTh}}ยังไม่พบ Skill Items — ตรวจว่าเปิดใช้ Compendium Module และนำเข้า/เปิดใช้งาน Skill Pack แล้ว จากนั้นเปิด Wizard ใหม่ หรือสร้างทักษะด้วย Items Directory{{else}}No Skill Items found. Enable/import the content module's Skill Pack and reopen the Wizard, or create Skills in the Items Directory.{{/if}}</p>{{/unless}}
        <div class="wiz-skill-list">
          {{#each skillRows as |s|}}
            <div class="wiz-skill-row {{#if s.isOcc}}is-occ{{/if}}" data-search="{{s.searchText}}">
              <div class="wiz-skill-name" data-tooltip="{{s.description}}" title="{{s.description}}">
                {{#if s.isOcc}}<span class="occ-tag">อาชีพ</span>{{/if}}
                <span>{{s.name}}</span>{{#if @root.isTh}}<small class="wiz-english-ref" lang="en">{{s.nameEn}}</small>{{/if}}
                <small>({{s.base}}%{{#if s.bonusCategory}} · {{#if @root.isTh}}หมวด{{else}}Cat{{/if}} {{s.bonusCategory}}{{/if}}{{#if s.personalityPts}} · Personality +{{s.personalityPts}}{{/if}})</small>
              </div>
              <div class="wiz-alloc-grp">
                <span class="sr-only">{{#if @root.isTh}}แต้มอาชีพ{{else}}Occupation{{/if}}</span>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="occ" data-delta="-5">-5</button>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="occ" data-delta="-1">−</button>
                <span class="alloc-num">{{s.occPts}}</span>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="occ" data-delta="1">+</button>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="occ" data-delta="5">+5</button>
              </div>
              <div class="wiz-alloc-grp">
                <span class="sr-only">{{#if @root.isTh}}แต้มส่วนตัว{{else}}Personal{{/if}}</span>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="pers" data-delta="-5">-5</button>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="pers" data-delta="-1">−</button>
                <span class="alloc-num">{{s.persPts}}</span>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="pers" data-delta="1">+</button>
                <button type="button" class="step-btn" data-action="allocateSkill" data-index="{{s.index}}" data-pool="pers" data-delta="5">+5</button>
              </div>
              <strong class="wiz-skill-total {{#if s.atCap}}at-cap{{/if}}">{{s.total}}%</strong>
            </div>
          {{/each}}
        </div>

      </div>
    {{/if}}
    {{#if isStep5}}
      <div class="panel-card wiz-section">
        <h3>{{#if isTh}}ขั้นที่ 8 (หน้า 16): ทรัพย์สินและอุปกรณ์เริ่มต้น{{else}}Rulebook Step 8: Possessions{{/if}}</h3>
        <div class="wiz-gear-box">
          {{#if profStarterReferences.length}}
          <div class="wiz-starter-library-refs"><strong>{{#if isTh}}อุปกรณ์จาก Occupation Item / คลัง{{else}}Equipment from Occupation Item / Library{{/if}}</strong>
            {{#each profStarterReferences as |entry|}}<label class="wiz-check"><input type="checkbox" data-action="toggleStarterReference" data-gear-type="{{entry.type}}" data-ref="{{entry.ref}}" {{checked entry.checked}} /> {{entry.label}}</label>{{/each}}
          </div>{{/if}}
          {{#unless profStarterReferences.length}}
          <p class="meta-text">{{#if isTh}}ยังไม่มีอุปกรณ์อ้างอิงจาก Occupation Item — สามารถเพิ่มจากชีทภายหลังได้{{else}}No starter equipment references; you may add gear on the character sheet later.{{/if}}</p>
          {{/unless}}
        </div>
      </div>
      <div class="panel-card wiz-section">
        <h3>{{#if isTh}}ขั้นที่ 9 (หน้า 16): รูปลักษณ์และข้อมูลส่วนตัว{{else}}Rulebook Step 9: Size & Distinctive Features{{/if}}</h3>
        <div class="wiz-grid-2">
          <label class="field-box"><span>{{#if isTh}}มือถนัด{{else}}Handedness{{/if}}</span><input type="text" data-wiz-field="handedness" value="{{wizardData.handedness}}" /></label>
          <label class="field-box"><span>{{#if isTh}}ส่วนสูง{{else}}Height{{/if}}</span><input type="text" data-wiz-field="height" value="{{wizardData.height}}" /></label>
          <label class="field-box"><span>{{#if isTh}}น้ำหนัก{{else}}Weight{{/if}}</span><input type="text" data-wiz-field="weight" value="{{wizardData.weight}}" /></label>
          <label class="field-box"><span>{{#if isTh}}เทพเจ้า/ศาสนา{{else}}Gods / Religion{{/if}}</span><input type="text" data-wiz-field="religion" value="{{wizardData.religion}}" /></label>
          <label class="field-box"><span>{{#if isTh}}ลักษณะเด่น{{else}}Distinctive Features{{/if}}</span><input type="text" data-wiz-field="distinctiveFeatures" value="{{wizardData.distinctiveFeatures}}" /></label>
          <label class="field-box"><span>{{#if isTh}}คำบรรยาย{{else}}Description{{/if}}</span><input type="text" data-wiz-field="personalDescription" value="{{wizardData.personalDescription}}" /></label>
        </div>
        <p class="meta-text">{{#if isTh}}หากไม่ต้องการระบุตัวเลขส่วนสูง/น้ำหนัก สามารถใช้คำบรรยายแทนได้ตามหนังสือกฎ{{else}}Height and weight may be descriptive, not strictly numeric, as permitted by the rulebook.{{/if}}</p>
      </div>
    {{/if}}
    {{#if isStep6}}
      {{#if isCompletedActor}}
        <div class="panel-card wiz-rebuild-protection" role="status">
          <strong>{{#if isTh}}ตัวละครนี้สร้างเสร็จแล้ว — ป้องกันข้อมูลเดิม{{else}}This character is complete — existing data protected{{/if}}</strong>
          <p>{{#if isTh}}การบันทึก Wizard อีกครั้งอาจเปลี่ยนค่าสถานะและแต้มที่มีอยู่ จึงต้องให้ GM ยืนยันก่อน ทักษะและแต้มปกติสามารถปรับจาก Character Sheet ได้{{else}}Re-running creation could change statistics or starting allocations. A GM must explicitly unlock rebuilding. Use the Character Sheet for ordinary skill edits.{{/if}}</p>
          {{#if @root.isGM}}
            {{#unless allowRebuild}}<button class="brp-btn" type="button" data-action="unlockRebuild">{{#if isTh}}ยืนยันเปิดสิทธิ์แก้ไขตัวละครเดิม{{else}}Unlock character rebuild (GM){{/if}}</button>
            {{else}}<strong>{{#if isTh}}ปลดล็อกการสร้างซ้ำแล้ว — ตรวจสอบก่อนบันทึก{{else}}Rebuild unlocked — review carefully before saving{{/if}}</strong>{{/unless}}
          {{/if}}
        </div>
      {{/if}}
      <div class="panel-card wiz-section">
        <h3><i class="fa-solid fa-clipboard-check"></i> {{#if isTh}}ขั้นที่ 10: ตรวจสอบข้อมูลและบันทึกตัวละคร{{else}}Step 10: Finishing Touches & Review{{/if}}</h3>
        <div class="wiz-review-progress">
          <div><span>{{#if isTh}}แต้มอาชีพใช้แล้ว{{else}}Occupation allocated{{/if}}</span><strong>{{occUsed}} / {{occBudget}}</strong><small>{{#if isTh}}คงเหลือ{{else}}Remaining{{/if}} {{occRemaining}} pt</small></div>
          <div><span>{{#if isTh}}แต้มส่วนตัวใช้แล้ว{{else}}Personal allocated{{/if}}</span><strong>{{persUsed}} / {{persBudget}}</strong><small>{{#if isTh}}คงเหลือ{{else}}Remaining{{/if}} {{persRemaining}} pt</small></div>
          <div><span>{{#if isTh}}ทักษะที่ปรับแต้ม{{else}}Allocated skills{{/if}}</span><strong>{{topSkills.length}}</strong><small>{{#if isTh}}ทักษะ{{else}}skills{{/if}}</small></div>
        </div>
        <div class="wiz-rules-summary">{{#if isTh}}ข้อมูลส่วนตัว ชื่อ อาชีพ และอายุจะบันทึกลงแผ่นตัวละครโดยไม่ลบข้อมูลที่มีอยู่{{else}}Personal data and characteristics will be saved on the character sheet{{/if}}</div>
        <p class="wiz-summary-head"><strong>{{wizardData.name}}</strong> · {{selectedProfession.title}} · {{wizardData.culture}} · {{#if isTh}}อายุ{{else}}Age{{/if}} {{wizardData.age}} · Personality: {{wizardData.personalityType}}</p>
        <div class="wiz-rules-summary">{{#if isTh}}อายุอ้างอิง{{else}}Reference age{{/if}}: {{ageRule.reference}} · {{#if isTh}}แต้มอาชีพตามอายุ{{else}}Occupation age adjustment{{/if}} {{ageRule.occupationDelta}} · EDU +{{ageRule.eduBonus}}</div>
        <div class="wiz-derived-preview">
          {{#each characteristics as |c|}}
            <span>{{c.short}}: <strong>{{c.value}}</strong></span>
          {{/each}}
        </div>
        <div class="wiz-derived-preview">
          <span>HP: <strong>{{derivedPreview.maxHp}}</strong></span>
          <span>PP: <strong>{{derivedPreview.maxPp}}</strong></span>
          <span>FP: <strong>{{derivedPreview.maxFp}}</strong></span>
          <span>SAN: <strong>{{derivedPreview.san}}</strong></span>
          <span>DM: <strong>{{derivedPreview.dm}}</strong></span>
        </div>
        {{#if powerCount}}<div class="wiz-top-skills"><strong>{{#if isTh}}พลังที่เลือก{{else}}Selected powers{{/if}} ({{powerCount}})</strong><div class="wiz-chips">{{#each powerRows as |p|}}<span class="wiz-chip">{{p.name}}: <strong>{{#if p.allocated}}{{p.total}}%{{else}}—{{/if}}</strong></span>{{/each}}</div></div>{{/if}}
        <div class="wiz-top-skills">
          <strong>{{#if isTh}}ทักษะอาชีพและทักษะที่จัดสรรแต้ม ({{topSkills.length}}):{{else}}Occupation and Allocated Skills ({{topSkills.length}}):{{/if}}</strong>
          <div class="wiz-chips">
            {{#each topSkills as |sk|}}
              <span class="wiz-chip" data-tooltip="{{#if @root.isTh}}อาชีพ{{else}}Occupation{{/if}} +{{sk.occPts}} · {{#if @root.isTh}}ส่วนตัว{{else}}Personal{{/if}} +{{sk.persPts}}">{{sk.name}}: <strong>{{sk.total}}%</strong></span>
            {{/each}}
          </div>
        </div>
      </div>
    {{/if}}
  </section>

  <footer class="wiz-footer">
    <button type="button" class="brp-btn" data-action="prevStep" {{#if isStep1}}disabled{{/if}}>
      ◀ {{#if isTh}}ย้อนกลับ{{else}}Back{{/if}}
    </button>
    {{#unless isStep6}}
      <button type="button" class="brp-btn primary" data-action="nextStep">
        {{#if isTh}}ขั้นตอนถัดไป{{else}}Next{{/if}} ▶
      </button>
    {{else}}
      <button type="button" class="brp-btn primary" data-action="finishWizard">
        ✓ {{#if isTh}}สร้างตัวละครและบันทึกลงชีท{{else}}Create & Save Character{{/if}}
      </button>
    {{/unless}}
  </footer>
</div>