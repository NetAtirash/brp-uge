                <button type="button" class="brp-btn" data-action="recoverPool" data-recover="hp1">+1 HP</button>
                <button type="button" class="brp-btn" data-action="recoverPool" data-recover="hp1d3">+1D3 HP</button>
                <button type="button" class="brp-btn" data-action="recoverPool" data-recover="pp25">+25% PP</button>
