              <strong class="{{#if entry.positive}}point-positive{{else}}{{#if entry.negative}}point-negative{{/if}}{{/if}}">{{entry.points}}%</strong>
              <div class="row-actions"><button type="button" class="icon-btn" data-action="editAdvancement" data-log-id="{{entry.id}}" data-tooltip="{{#if @root.isTh}}แก้ไข{{else}}Edit{{/if}}"><i class="fa-solid fa-pen"></i></button><button type="button" class="icon-btn danger" data-action="deleteAdvancement" data-log-id="{{entry.id}}" data-tooltip="{{#if @root.isTh}}ลบ{{else}}Delete{{/if}}"><i class="fa-solid fa-trash"></i></button></div>
            </div>
          {{else}}
            <p class="empty-hint"><i class="fa-solid fa-book-open"></i> {{#if isTh}}ยังไม่มีประวัติการพัฒนา เพิ่มรายการแรกด้วยปุ่มด้านบน{{else}}No advancements recorded yet{{/if}}</p>
          {{/each}}
        </div>
      {{/if}}

      {{#if isNotesTab}}
        <div class="panel-card notes-board">
          <div class="panel-header"><h3><i class="fa-solid fa-book-open"></i> {{#if isTh}}สมุดบันทึกตัวละคร{{else}}Character Notes{{/if}}</h3><button type="button" class="brp-btn primary" data-action="createNote"><i class="fa-solid fa-plus"></i> {{#if isTh}}สร้างหัวข้อใหม่{{else}}New note{{/if}}</button></div>
          <input class="notes-search" dir="auto" type="search" data-note-filter value="{{noteFilter}}" placeholder="{{#if isTh}}ค้นหาชื่อ หมวดหมู่ หรือเนื้อหาบันทึก...{{else}}Search notes, categories, contents...{{/if}}" />
          <div class="notes-grid">{{#each journalEntries as |note|}}
            <article class="note-card" data-note-search="{{note.title}} {{note.category}} {{note.description}}"><header><span class="note-category"><i class="fa-solid fa-tag"></i> {{note.category}}</span><small>{{note.createdAt}}</small></header>
              <h4>{{note.title}}</h4><p class="note-description">{{note.description}}</p>
              <div class="note-actions"><button type="button" class="brp-btn" data-action="shareNote" data-note-id="{{note.id}}"><i class="fa-solid fa-comment-dots"></i> {{#if @root.isTh}}แชร์ในแชท{{else}}Share to chat{{/if}}</button><button type="button" class="icon-btn" data-action="editNote" data-note-id="{{note.id}}"><i class="fa-solid fa-pen"></i></button><button type="button" class="icon-btn danger" data-action="deleteNote" data-note-id="{{note.id}}"><i class="fa-solid fa-trash"></i></button></div>
            </article>
          {{else}}<p class="empty-hint">{{#if isTh}}ยังไม่มีหัวข้อบันทึก{{else}}No notes yet{{/if}}</p>{{/each}}</div>
          {{#if legacyNotes}}<details class="legacy-notes"><summary>{{#if isTh}}บันทึกเดิม (จากเวอร์ชันก่อนหน้า){{else}}Legacy notes{{/if}}</summary><textarea name="system.notes" class="notes-area">{{legacyNotes}}</textarea></details>{{/if}}
        </div>
      {{/if}}
    </section>
  </main>
</div>