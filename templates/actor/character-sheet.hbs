                <button type="button" class="brp-btn" data-action="recoverPool" data-recover="san1">+1 SAN</button>
                <button type="button" class="brp-btn" data-action="recoverPool" data-recover="san1d6">+1D6 SAN</button>
                <button type="button" class="brp-btn" data-action="recoverPool" data-recover="longRest">{{#if isTh}}พักผ่อนเต็มที่{{else}}Long rest{{/if}}</button>
