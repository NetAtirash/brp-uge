              </div>
            </details>
          </div>

          <div class="combat-split">
            <div class="panel-card">
              <div class="panel-header">
                <h3><i class="fa-solid fa-kit-medical" aria-hidden="true"></i> {{#if isTh}}บาดแผล{{else}}Wounds{{/if}} · {{activeWoundsCount}}</h3>
                <button type="button" class="brp-btn primary" data-action="addWound">+ {{#if isTh}}บันทึกบาดแผล{{else}}Add wound{{/if}}</button>
              </div>
              <ul class="item-list">
                {{#each woundsList as |w|}}
                  <li class="wound-row {{#if w.healed}}is-resolved{{/if}}">
                    <div class="wound-main">
                      <div class="wound-title-row">
                        <strong>{{w.title}}</strong>
                        <span class="wound-badge {{w.severity}}">{{w.severityLabel}}</span>
                        {{#if w.careStatus}}<span class="meta-text">{{w.careStatus}}</span>{{/if}}
                        <span class="meta-text">-{{w.hpLost}} HP · {{w.location}} · {{#if @root.isTh}}ฟื้นแล้ว{{else}}Recovered{{/if}} +{{w.recoveryHp}} HP · {{#if @root.isTh}}ปฐมพยาบาล{{else}}First Aid{{/if}}: {{#if w.firstAidAttempted}}{{#if @root.isTh}}ใช้สิทธิ์แล้ว{{else}}Attempted{{/if}}{{else}}—{{/if}}</span>
                      </div>
                      {{#if w.notes}}<div class="meta-text">{{w.notes}}{{#if w.createdAt}} · {{w.createdAt}}{{/if}}</div>{{/if}}
                      {{#if w.majorDetermined}}<div class="brp-major-detail"><strong>Major Wound 1D100: {{w.majorRoll}}</strong> · {{#if @root.isTh}}{{w.majorEffectTh}}{{else}}{{w.majorEffectEn}}{{/if}} · {{#if w.majorLuckPassed}}Luck ✓ {{#if @root.isTh}}ไม่เสียค่าสถานะถาวร{{else}}No permanent stat loss{{/if}}{{else}}{{#if w.majorApplied}}{{#if @root.isTh}}ลดค่าสถานะแล้ว{{else}}Stat loss applied{{/if}}: {{w.majorLossSummary}}{{else}}{{#if @root.isTh}}GM เลือกค่าสถานะที่เสีย{{else}}GM to assign losses{{/if}}{{/if}}{{/if}}</div>{{/if}}
                    </div>
                    <div class="comp-actions">
                      {{#if (eq w.severity "major")}}{{#unless w.majorDetermined}}<button type="button" class="brp-btn" data-action="rollMajorWound" data-wound-id="{{w.id}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> Major Wound</button>{{/unless}}{{/if}}
                      <button type="button" class="brp-btn {{#if w.healed}}is-active{{/if}}" data-action="toggleHealWound" data-wound-id="{{w.id}}">
                        {{#if w.healed}}{{#if @root.isTh}}ปิดบาดแผลแล้ว ✓{{else}}Resolved ✓{{/if}}{{else}}{{#if @root.isTh}}ทำเครื่องหมายหาย{{else}}Mark healed{{/if}}{{/if}}
                      </button>
                      <button type="button" class="icon-btn danger" data-action="deleteWound" data-wound-id="{{w.id}}" title="{{#if @root.isTh}}ลบบันทึก{{else}}Delete record{{/if}}">✕</button>
                    </div>
                  </li>
                {{else}}
                  <li class="toolbar-hint">{{#if isTh}}ไม่มีบาดแผล{{else}}No wounds{{/if}}</li>
                {{/each}}
              </ul>
            </div>

            <div class="panel-card">
              <div class="panel-header">
                <h3><i class="fa-solid fa-brain" aria-hidden="true"></i> {{#if isTh}}อาการทางจิต{{else}}Mental conditions{{/if}} · {{activeInsanitiesCount}}</h3>
                <button type="button" class="brp-btn primary" data-action="addInsanity">+ {{#if isTh}}บันทึกอาการ{{else}}Add condition{{/if}}</button>
              </div>
              <ul class="item-list">
                {{#each insanitiesList as |c|}}
                  <li class="wound-row {{#if c.cured}}is-resolved{{/if}}">
                    <div class="wound-main">
                      <div class="wound-title-row">
                        <strong>{{c.title}}</strong>
                        <span class="wound-badge {{c.kind}}">{{c.kindLabel}}</span>
                        {{#if c.careStatus}}<span class="meta-text">{{c.careStatus}}</span>{{/if}}
                        <span class="meta-text">-{{c.sanLost}} SAN · {{c.duration}} · {{#if @root.isTh}}ฟื้นแล้ว{{else}}Recovered{{/if}} +{{c.recoverySan}} SAN</span>
                      </div>
                      {{#if c.notes}}<div class="meta-text">{{c.notes}}{{#if c.createdAt}} · {{c.createdAt}}{{/if}}</div>{{/if}}
                    </div>
                    <div class="comp-actions">
                      <button type="button" class="brp-btn {{#if c.cured}}is-active{{/if}}" data-action="toggleCureInsanity" data-cond-id="{{c.id}}">
                        {{#if c.cured}}{{#if @root.isTh}}ปิดอาการแล้ว ✓{{else}}Resolved ✓{{/if}}{{else}}{{#if @root.isTh}}ทำเครื่องหมายหาย{{else}}Mark resolved{{/if}}{{/if}}
                      </button>
                      <button type="button" class="icon-btn danger" data-action="deleteInsanity" data-cond-id="{{c.id}}" title="{{#if @root.isTh}}ลบบันทึก{{else}}Delete record{{/if}}">✕</button>
                    </div>
                  </li>
                {{else}}
                  <li class="toolbar-hint">{{#if isTh}}ไม่มีอาการทางจิต{{else}}No mental conditions{{/if}}</li>
                {{/each}}
              </ul>
            </div>
          </div>
        </div>
      {{/if}}

      {{#if isInventoryTab}}
        <div class="inventory-layout">
          <div class="panel-card brp-wallet-panel">
            <div class="panel-header"><h3><i class="fa-solid fa-coins"></i> {{#if isTh}}การเงิน / Currency{{else}}Finances / Currency{{/if}}</h3></div>
            {{#if activeWealth}}<div class="brp-wealth-level brp-readonly-value" aria-live="polite"><span class="brp-display-label">{{#if isTh}}ฐานะตามอาชีพ{{else}}Occupational wealth{{/if}}</span>
              <strong>{{activeWealth}}</strong>
            </div>{{/if}}
            <div class="brp-currency-grid">{{#each currencyRows as |unit|}}
              <label>{{unit.unit}} <input type="number" step="1" value="{{unit.amount}}" data-currency-unit="{{unit.unit}}" {{#unless @root.editMode}}readonly{{/unless}} /></label>
            {{/each}}</div>
            {{#if isGM}}{{#if editMode}}<p class="meta-text brp-gm-guidance">{{#if isTh}}ตั้งค่าหน่วยเงิน: World Settings → BRP UGE{{else}}Currency units: World Settings → BRP UGE{{/if}}</p>{{/if}}{{/if}}
          </div>
          <div class="inventory-heading"><h3><i class="fa-solid fa-box-open"></i> {{#if isTh}}สิ่งของและสัมภาระ{{else}}Inventory & Equipment{{/if}}</h3><span>{{inventoryCount}} {{#if isTh}}รายการ{{else}}items{{/if}}</span></div>
          <div class="panel-card inventory-panel">
            <div class="panel-header"><h3><i class="fa-solid fa-sword"></i> {{ui.weaponsTitle}} ({{weapons.length}})</h3>
              <div class="toolbar-btns"><button type="button" class="brp-btn" data-action="openCompendium" data-category="weapons"><i class="fa-solid fa-book"></i> {{ui.browseWeapons}}</button>{{#if editMode}}<button type="button" class="brp-btn" data-action="createItem" data-type="weapon"><i class="fa-solid fa-plus"></i> {{ui.addWeapon}}</button>{{/if}}</div>
            </div>
            <ul class="item-list">{{#each weapons as |item|}}
              <li class="item-row" data-item-id="{{item.id}}" data-tooltip="{{item.localizedTooltip}}"><img class="item-type-icon" src="{{item.img}}" alt="" />
                <button type="button" class="exp-toggle {{#if item.system.equipped}}checked{{/if}}" data-action="toggleEquipped" data-tooltip="{{#if @root.isTh}}พกพา/สวมใส่{{else}}Equipped{{/if}}">{{#if item.system.equipped}}✓{{else}}☐{{/if}}</button>
                <button type="button" class="brp-share-label item-label" data-action="shareEntry">{{item.displayName}}</button><span class="meta-text">{{item.system.damage}}</span>
                <button type="button" class="icon-btn" data-action="rollWeapon" data-tooltip="{{#if @root.isTh}}โจมตี{{else}}Attack{{/if}}"><i class="fa-solid fa-dice-d20"></i></button>
                {{#if @root.editMode}}<button type="button" class="icon-btn" data-action="editItem"><i class="fa-solid fa-pen"></i></button><button type="button" class="icon-btn danger" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>{{/if}}
              </li>{{/each}}
            </ul>
          </div>
          <div class="panel-card inventory-panel">
            <div class="panel-header"><h3><i class="fa-solid fa-shield-halved"></i> {{ui.armorTitle}} ({{armor.length}})</h3>
              <div class="toolbar-btns"><button type="button" class="brp-btn" data-action="openCompendium" data-category="armor"><i class="fa-solid fa-book"></i> {{ui.browseArmor}}</button>{{#if editMode}}<button type="button" class="brp-btn" data-action="createItem" data-type="armor"><i class="fa-solid fa-plus"></i> {{ui.addArmor}}</button>{{/if}}</div>
            </div>
            <ul class="item-list">{{#each armor as |item|}}
              <li class="item-row" data-item-id="{{item.id}}" data-tooltip="{{item.localizedTooltip}}"><img class="item-type-icon" src="{{item.img}}" alt="" />
                <button type="button" class="exp-toggle {{#if item.system.equipped}}checked{{/if}}" data-action="toggleEquipped" data-tooltip="{{#if @root.isTh}}สวมใส่/ถอด{{else}}Equip/Unequip{{/if}}">{{#if item.system.equipped}}✓{{else}}☐{{/if}}</button>
                <button type="button" class="brp-share-label item-label" data-action="shareEntry">{{item.displayName}}</button><strong class="skill-total">{{item.system.ap}} AP</strong>
                {{#if @root.editMode}}<button type="button" class="icon-btn" data-action="editItem"><i class="fa-solid fa-pen"></i></button><button type="button" class="icon-btn danger" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>{{/if}}
              </li>{{/each}}
            </ul>
          </div>
          <div class="panel-card inventory-panel">
            <div class="panel-header"><h3><i class="fa-solid fa-bag-shopping"></i> {{ui.gearTitle}} ({{gear.length}})</h3>
              <div class="toolbar-btns"><button type="button" class="brp-btn" data-action="openCompendium" data-category="gear"><i class="fa-solid fa-book"></i> {{ui.browseGear}}</button>{{#if editMode}}<button type="button" class="brp-btn" data-action="createItem" data-type="gear"><i class="fa-solid fa-plus"></i> {{ui.addGear}}</button>{{/if}}</div>
            </div>
            <ul class="item-list">{{#each gear as |item|}}
              <li class="item-row" data-item-id="{{item.id}}" data-tooltip="{{item.localizedTooltip}}"><img class="item-type-icon" src="{{item.img}}" alt="" />
                <button type="button" class="brp-share-label item-label" data-action="shareEntry">{{item.displayName}}</button><span class="meta-text">{{item.system.weight}} kg</span>
                {{#if @root.editMode}}<button type="button" class="step-btn" data-action="stepItemValue" data-item-path="system.quantity" data-delta="-1" data-min="0">−</button><input type="number" min="0" class="inline-num" data-item-field="system.quantity" value="{{item.system.quantity}}" /><button type="button" class="step-btn" data-action="stepItemValue" data-item-path="system.quantity" data-delta="1">+</button>{{else}}<strong>x{{item.system.quantity}}</strong>{{/if}}
                {{#if @root.editMode}}<button type="button" class="icon-btn" data-action="editItem"><i class="fa-solid fa-pen"></i></button><button type="button" class="icon-btn danger" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>{{/if}}
              </li>{{/each}}
            </ul>
          </div>
        </div>
      {{/if}}

      {{#if isStatusTab}}
        <div class="brp-status-layout">
          <section class="panel-card brp-status-panel">
            <div class="panel-header"><h3><i class="fa-solid fa-hourglass-half"></i> {{#if isTh}}อายุและผลต่อค่าสถานะ{{else}}Age and characteristic effects{{/if}}</h3></div>
            {{#if editMode}}
              <div class="brp-status-age-grid">
                <label>{{#if isTh}}อายุเริ่มต้น{{else}}Starting age{{/if}}
                  <input type="number" data-dtype="Number" min="0" step="1" required name="system.startingAge" value="{{startingAgeForEdit}}" />
                </label>
                <label>{{#if isTh}}อายุปัจจุบัน{{else}}Current age{{/if}}
                  <input type="number" data-dtype="Number" min="0" step="1" required name="system.age" value="{{system.age}}" />
                </label>
                <label class="brp-age-check"><input type="checkbox" name="system.applyAgingRules" {{checked system.applyAgingRules}} /> {{#if isTh}}ใช้เกณฑ์อายุ 50+ ตามขั้นสร้างตัวละคร{{else}}Apply 50+ character creation aging thresholds{{/if}}</label>
                <label>{{#if isTh}}ลำดับค่าสถานะที่ลด (STR, CON, DEX, CHA){{else}}Aging stat choices (STR, CON, DEX, CHA){{/if}}
                  <input name="system.agingPriority" type="text" value="{{system.agingPriority}}" />
                </label>
              </div>
              <p class="meta-text">{{#if isTh}}อายุที่เพิ่มหลังสร้างตัวละคร: {{ageBreakdown.yearsElapsed}} ปี · ผลจากช่วงอายุที่ผ่านเพิ่ม:{{else}}Years since creation: {{ageBreakdown.yearsElapsed}} · New milestone effects:{{/if}} <strong>{{#if ageAfterStartSummary}}{{ageAfterStartSummary}}{{else}}—{{/if}}</strong></p>
              {{#if ageBreakdown.invalidAgeOrder}}<p class="brp-age-warning">{{#if isTh}}อายุปัจจุบันต่ำกว่าอายุตั้งต้นได้โดยไม่ถูกบล็อก (หากเป็นตัวละครที่เพิ่งสร้าง แนะนำให้ปรับอายุตั้งต้นให้ตรงด้วย) และจะไม่เกิดโทษจากอายุที่ยังไม่ถึง{{else}}Current age can be below starting age. For a newly created character, consider aligning starting age. Future age penalties are not applied early.{{/if}}</p>{{/if}}
              <p class="meta-text">{{#if isTh}}อายุ 50, 60, 70: ลด 1 ค่าที่เลือกต่อทศวรรษ; อายุ 80+ ลด 3 ค่าต่อทศวรรษ (ขั้นสร้างตัวละคร หน้า 10). กฎเสริม Aging & Inaction หน้า 120 ใช้การทอยรายปีแยกต่างหาก ไม่ได้สุ่มอัตโนมัติ{{else}}At 50, 60, 70: -1 to a chosen stat per decade; at 80+: -1 to three chosen stats per decade (creation rules p.10). Optional annual Aging & Inaction (p.120) uses separate rolls, not automated here.{{/if}}</p>
            {{else}}
              <p class="brp-age-current">{{#if isTh}}อายุปัจจุบัน{{else}}Current age{{/if}} <strong>{{system.age}}</strong></p>
            {{/if}}
            <p class="meta-text">{{#if isTh}}ผลปรับค่าสถานะจากอายุ:{{else}}Age-related characteristic modifiers:{{/if}} <strong>{{#if agePenaltySummary}}{{agePenaltySummary}}{{else}}—{{/if}}</strong></p>
          </section>
          <section class="panel-card brp-status-panel">
            <div class="panel-header"><h3><i class="fa-solid fa-briefcase"></i> {{#if isTh}}อาชีพ (Item แบบลากวาง){{else}}Occupation (draggable Item){{/if}}</h3>
              <div class="toolbar-btns"><button type="button" class="brp-btn action-library" data-action="openCompendium" data-category="occupations"><i class="fa-solid fa-book-atlas"></i> {{#if isTh}}เพิ่มจากคลัง{{else}}Browse occupations{{/if}}</button>
              {{#if editMode}}<button type="button" class="brp-btn" data-action="createItem" data-type="occupation"><i class="fa-solid fa-plus"></i> {{#if isTh}}สร้างอาชีพ{{else}}New occupation{{/if}}</button>{{/if}}</div>
            </div>
            {{#if editMode}}<p class="meta-text brp-context-guidance">{{#if isTh}}ลากอาชีพจาก Items Directory เพื่อเพิ่มให้ตัวละคร{{else}}Drop an Occupation item here to assign it{{/if}}</p>{{/if}}
            {{#each occupationItems as |job|}}<div class="brp-status-row" data-item-id="{{job.id}}"><button type="button" class="brp-share-label" data-action="shareEntry">{{job.name}}</button>{{#if job.wealth}}<span class="brp-occupation-wealth">{{job.wealth}}</span>{{/if}}
              {{#unless job.active}}<button type="button" class="brp-btn" data-action="activateOccupation" title="Make active">{{#if @root.isTh}}ใช้{{else}}Use{{/if}}</button>{{else}}<span class="brp-occupation-active"><i class="fa-solid fa-check-circle"></i> {{#if @root.isTh}}ปัจจุบัน{{else}}Active{{/if}}</span>{{/unless}}
              <button type="button" class="icon-btn" data-action="editItem" title="Edit"><i class="fa-solid fa-pen"></i></button>
              {{#if @root.editMode}}<button type="button" class="icon-btn danger" data-action="deleteItem" title="Remove"><i class="fa-solid fa-trash"></i></button>{{/if}}
            </div>{{/each}}
          </section>
          <section class="panel-card brp-status-panel">
            <div class="panel-header"><h3><i class="fa-solid fa-person-circle-exclamation"></i> {{#if isTh}}ผลของสถานะ (Conditions & Modifiers){{else}}Status effects & modifiers{{/if}}</h3>
              <div class="toolbar-btns"><button type="button" class="brp-btn action-library" data-action="openCompendium" data-category="statuses"><i class="fa-solid fa-book-atlas"></i> {{#if isTh}}เพิ่มจากคลัง{{else}}Browse conditions{{/if}}</button>
              <button type="button" class="brp-btn primary" data-action="createStatus"><i class="fa-solid fa-plus"></i> {{#if isTh}}เพิ่มสถานะ{{else}}Add effect{{/if}}</button></div>
            </div>
            {{#if editMode}}<p class="meta-text brp-context-guidance">{{#if isTh}}สถานะและตัวปรับค่าชั่วคราว (ไม่เปลี่ยนค่าพื้นฐาน){{else}}Temporary modifiers (base values unchanged){{/if}}</p>{{/if}}
            {{#each statusRows as |st|}}<div class="brp-status-row {{#unless st.active}}inactive{{/unless}}" data-status-id="{{st.id}}">
              <div><strong>{{st.name}}</strong><div class="meta-text">{{st.source}} · {{st.characteristicLabel}} {{st.signedStat}} · {{st.scopeLabel}} {{st.signedSkill}}{{#if st.makeDifficult}} · Difficult{{/if}}</div>{{#if st.notes}}<div class="meta-text">{{st.notes}}</div>{{/if}}</div>
              <button type="button" class="brp-btn" data-action="toggleStatus">{{#if st.active}}{{#if @root.isTh}}เปิด{{else}}On{{/if}}{{else}}{{#if @root.isTh}}ปิด{{else}}Off{{/if}}{{/if}}</button>
              <button type="button" class="icon-btn" data-action="editStatus" title="Edit"><i class="fa-solid fa-pen"></i></button>
              <button type="button" class="icon-btn danger" data-action="deleteStatus" title="Delete"><i class="fa-solid fa-trash"></i></button>
            </div>{{else}}<p class="empty-hint">{{#if isTh}}ยังไม่มีสถานะเพิ่มเติม{{else}}No status effects yet{{/if}}</p>{{/each}}
          </section>
        </div>
      {{/if}}

      {{#if isAdvancementTab}}
        <div class="panel-card advancement-board">
          <div class="panel-header"><div><h3><i class="fa-solid fa-chart-line"></i> {{#if isTh}}บันทึกการพัฒนาตัวละคร{{else}}Character Advancement Log{{/if}}</h3><p class="meta-text">{{#if isTh}}การเพิ่มหรือแก้แต้มในหน้านี้จะเปลี่ยนค่าทักษะ/พลังทันที ส่วนแต้มฝึกฝนในหน้าทักษะอ่านอย่างเดียว{{else}}Add or edit entries here; Skill training is read-only elsewhere{{/if}}</p></div>
