{{! UI2 personal field component: preserves every existing system.* input and action. }}
<div class="brp-ui2-profile-grid" role="group" aria-label="{{#if isTh}}ข้อมูลส่วนตัว{{else}}Personal information{{/if}}">
      <label class="brp-personal-fact brp-personal-age"><span class="brp-personal-label">{{#if isTh}}อายุ{{else}}Age{{/if}}</span>{{#if editMode}}{{#unless isStatusTab}}<input class="brp-personal-input" name="system.age" type="number" data-dtype="Number" min="0" step="1" value="{{system.age}}" aria-label="{{#if isTh}}อายุ{{else}}Age{{/if}}" />{{else}}<span class="brp-personal-value">{{system.age}}</span>{{/unless}}{{else}}<span class="brp-personal-value">{{system.age}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-gender"><span class="brp-personal-label">{{#if isTh}}เพศ{{else}}Gender{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.gender" type="text" value="{{system.gender}}" placeholder="—" aria-label="{{#if isTh}}เพศ{{else}}Gender{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.gender}}{{system.gender}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-playerName"><span class="brp-personal-label">{{#if isTh}}ผู้เล่น{{else}}Player{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.playerName" type="text" value="{{system.playerName}}" placeholder="—" aria-label="{{#if isTh}}ผู้เล่น{{else}}Player{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.playerName}}{{system.playerName}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-culture"><span class="brp-personal-label">{{#if isTh}}วัฒนธรรม{{else}}Culture{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.culture" type="text" value="{{system.culture}}" placeholder="—" aria-label="{{#if isTh}}วัฒนธรรม{{else}}Culture{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.culture}}{{system.culture}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-handedness"><span class="brp-personal-label">{{#if isTh}}มือถนัด{{else}}Handedness{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.handedness" type="text" value="{{system.handedness}}" placeholder="—" aria-label="{{#if isTh}}มือถนัด{{else}}Handedness{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.handedness}}{{system.handedness}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-height"><span class="brp-personal-label">{{#if isTh}}ส่วนสูง{{else}}Height{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.height" type="text" value="{{system.height}}" placeholder="—" aria-label="{{#if isTh}}ส่วนสูง{{else}}Height{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.height}}{{system.height}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-weight"><span class="brp-personal-label">{{#if isTh}}น้ำหนัก{{else}}Weight{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.weight" type="text" value="{{system.weight}}" placeholder="—" aria-label="{{#if isTh}}น้ำหนัก{{else}}Weight{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.weight}}{{system.weight}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-wealth"><span class="brp-personal-label">{{#if isTh}}ฐานะ{{else}}Wealth{{/if}}</span><button type="button" class="brp-personal-value brp-personal-link" data-action="switchTab" data-tab="status" title="{{#if isTh}}แก้ไขฐานะผ่านอาชีพที่แท็บสถานะ{{else}}Manage wealth via Occupation in Status{{/if}}">{{#if activeWealth}}{{activeWealth}}{{else}}—{{/if}}</button></label>
      <label class="brp-personal-fact brp-personal-religion"><span class="brp-personal-label">{{#if isTh}}เทพเจ้า/ศาสนา{{else}}Gods / Religion{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.religion" type="text" value="{{system.religion}}" placeholder="—" aria-label="{{#if isTh}}เทพเจ้า/ศาสนา{{else}}Gods / Religion{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.religion}}{{system.religion}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-distinctiveFeatures"><span class="brp-personal-label">{{#if isTh}}ลักษณะเด่น{{else}}Distinctive Features{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.distinctiveFeatures" type="text" value="{{system.distinctiveFeatures}}" placeholder="—" aria-label="{{#if isTh}}ลักษณะเด่น{{else}}Distinctive Features{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.distinctiveFeatures}}{{system.distinctiveFeatures}}{{else}}—{{/if}}</span>{{/if}}</label>
      <label class="brp-personal-fact brp-personal-personalDescription"><span class="brp-personal-label">{{#if isTh}}คำบรรยาย{{else}}Description{{/if}}</span>{{#if editMode}}<input class="brp-personal-input" name="system.personalDescription" type="text" value="{{system.personalDescription}}" placeholder="—" aria-label="{{#if isTh}}คำบรรยาย{{else}}Description{{/if}}" />{{else}}<span class="brp-personal-value">{{#if system.personalDescription}}{{system.personalDescription}}{{else}}—{{/if}}</span>{{/if}}</label>
    </div>
