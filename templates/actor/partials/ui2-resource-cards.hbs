{{! UI2 Phase 1C: same Actor resource fields and actions, component-owned wrapper. }}
<!-- Compact Vitals 2-Col Grid -->
    <div class="brp-ui2-resource-cards">
      <div class="brp-ui2-resource-card brp-ui2-resource-compact" data-tooltip="{{derivedTips.hp}}">
        <div class="brp-ui2-resource-heading">
          <span class="brp-ui2-resource-label">HP</span>
          <span class="brp-ui2-resource-hint">MW ≥{{system.derived.majorWound}}</span>
        </div>
        <div class="brp-ui2-resource-value">
          <div class="brp-ui2-step-group brp-ui2-compact-step">
            {{#if editMode}}
              <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.hp.value" data-delta="-1" data-min="{{system.hp.min}}" data-max="{{system.hp.max}}">−</button>
            {{/if}}
            <input aria-label="HP current" name="system.hp.value" type="number" value="{{system.hp.value}}" />
            {{#if editMode}}
              <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.hp.value" data-delta="1" data-min="{{system.hp.min}}" data-max="{{system.hp.max}}">+</button>
            {{/if}}
          </div>
          <span class="brp-ui2-resource-max">/{{system.hp.max}}</span>
        </div>
        <progress class="brp-ui2-resource-meter" aria-label="HP" value="{{system.hp.value}}" max="{{system.hp.max}}"></progress>
        <div class="brp-ui2-resource-actions">
          <button type="button" class="brp-ui2-resource-action" data-action="switchTab" data-tab="wounds" title="{{#if isTh}}รักษาผ่านทักษะ First Aid / Medicine{{else}}Treat via First Aid / Medicine{{/if}}"><i class="fa-solid fa-kit-medical"></i> {{#if isTh}}รักษา{{else}}Treat{{/if}}</button>
        </div>
      </div>

      <div class="brp-ui2-resource-card brp-ui2-resource-compact" data-tooltip="{{derivedTips.pp}}">
        <div class="brp-ui2-resource-heading">
          <span class="brp-ui2-resource-label">PP</span>
          <span class="brp-ui2-resource-hint">EXP +{{system.derived.expBonus}}%</span>
        </div>
        <div class="brp-ui2-resource-value">
          <div class="brp-ui2-step-group brp-ui2-compact-step">
            {{#if editMode}}
              <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.pp.value" data-delta="-1" data-min="0" data-max="{{system.pp.max}}">−</button>
            {{/if}}
            <input aria-label="PP current" name="system.pp.value" type="number" value="{{system.pp.value}}" />
            {{#if editMode}}
              <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.pp.value" data-delta="1" data-min="0" data-max="{{system.pp.max}}">+</button>
            {{/if}}
          </div>
          <span class="brp-ui2-resource-max">/{{system.pp.max}}</span>
        </div>
        <progress class="brp-ui2-resource-meter" aria-label="PP" value="{{system.pp.value}}" max="{{system.pp.max}}"></progress>
        <div class="brp-ui2-resource-actions">
          <button type="button" class="brp-ui2-resource-action" data-action="recoverPool" data-recover="pp25" title="{{#if isTh}}ฟื้นฟู PP 25%{{else}}Recover PP 25%{{/if}}">+25%</button>
          <button type="button" class="brp-ui2-resource-action" data-action="recoverPool" data-recover="ppFull" title="{{#if isTh}}ฟื้นฟู PP เต็ม{{else}}Recover full PP{{/if}}">{{#if isTh}}เต็ม{{else}}Full{{/if}}</button>
        </div>
      </div>

      {{#if campaignRules.useSanity}}
        <div class="brp-ui2-resource-card brp-ui2-resource-compact brp-ui2-san-card" data-tooltip="{{derivedTips.san}}">
          <div class="brp-ui2-resource-heading">
            <span class="brp-ui2-resource-label">SAN</span>
            <button type="button" class="brp-ui2-san-roll" data-action="rollSanity">{{ui.rollSanBtn}}</button>
          </div>
          <div class="brp-ui2-resource-value">
            <div class="brp-ui2-step-group brp-ui2-compact-step">
              {{#if editMode}}
                <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.san.value" data-delta="-1" data-min="0" data-max="{{system.san.max}}">−</button>
              {{/if}}
              <input aria-label="SAN current" name="system.san.value" type="number" value="{{system.san.value}}" />
              {{#if editMode}}
                <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.san.value" data-delta="1" data-min="0" data-max="{{system.san.max}}">+</button>
              {{/if}}
            </div>
            <span class="brp-ui2-resource-max">/{{system.san.max}}</span>
          </div>
        <progress class="brp-ui2-resource-meter" aria-label="SAN" value="{{system.san.value}}" max="{{system.san.max}}"></progress>
          <div class="brp-ui2-resource-actions">
            <button type="button" class="brp-ui2-resource-action" data-action="switchTab" data-tab="wounds" title="{{#if isTh}}บำบัดผ่านทักษะจิตบำบัด{{else}}Psychotherapy treatment{{/if}}"><i class="fa-solid fa-brain"></i> {{#if isTh}}บำบัด{{else}}Therapy{{/if}}</button>
          </div>
        </div>
      {{/if}}

      {{#if campaignRules.useFatigue}}
        <div class="brp-ui2-resource-card brp-ui2-resource-compact brp-ui2-fp-card" data-tooltip="{{derivedTips.fp}}">
          <div class="brp-ui2-resource-heading">
            <span class="brp-ui2-resource-label">FP</span>
            <span class="brp-ui2-resource-hint">STR+CON</span>
          </div>
          <div class="brp-ui2-resource-value">
            <div class="brp-ui2-step-group brp-ui2-compact-step">
              {{#if editMode}}
                <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.fp.value" data-delta="-1" data-min="{{system.fp.min}}" data-max="{{system.fp.max}}">−</button>
              {{/if}}
              <input aria-label="FP current" name="system.fp.value" type="number" value="{{system.fp.value}}" />
              {{#if editMode}}
                <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.fp.value" data-delta="1" data-min="{{system.fp.min}}" data-max="{{system.fp.max}}">+</button>
              {{/if}}
            </div>
            <span class="brp-ui2-resource-max">/{{system.fp.max}}</span>
          </div>
        <progress class="brp-ui2-resource-meter" aria-label="FP" value="{{system.fp.value}}" max="{{system.fp.max}}"></progress>
        </div>
      {{/if}}
    </div>
