{{! UI2 Phase 1C: same effective/base characteristic data and roll actions. }}
<!-- Compact 2-Column Characteristics Block -->
    <div class="brp-ui2-characteristic-grid">
      {{#each characteristicsList as |c|}}
        <div class="brp-ui2-characteristic-card" data-tooltip="{{c.tooltip}}">
          <div class="brp-ui2-characteristic-top">
            <span class="brp-ui2-characteristic-label">{{c.short}}</span>
            <div class="brp-ui2-step-group brp-ui2-compact-step">
              {{#if @root.editMode}}
                <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.characteristics.{{c.key}}.value" data-delta="-1" data-min="1" data-max="99">−</button>
              {{/if}}
              {{#if @root.editMode}}
                <input name="system.characteristics.{{c.key}}.value" type="number" value="{{c.rawValue}}" />
              {{else}}
                <span class="brp-ui2-characteristic-value" title="Base {{c.rawValue}} / Status {{c.delta}}">{{c.effectiveValue}}</span>
              {{/if}}
              {{#if @root.editMode}}
                <button type="button" class="brp-ui2-step-button" data-action="stepActorValue" data-path="system.characteristics.{{c.key}}.value" data-delta="1" data-min="1" data-max="99">+</button>
              {{/if}}
            </div>
          </div>
          {{#if c.delta}}<div class="brp-ui2-characteristic-adjustment" title="Status/age modifiers">{{#if @root.isTh}}สถานะ{{else}}Status{{/if}} {{c.delta}} · {{#if @root.isTh}}พื้นฐาน{{else}}Base{{/if}} {{c.rawValue}}</div>{{/if}}
          <div class="brp-ui2-characteristic-actions brp-ui2-derived-roll">
            <button type="button" class="brp-ui2-share-action" data-action="shareEntry" data-char="{{c.key}}" data-tooltip="{{#if @root.isTh}}ส่งข้อมูลลงแชท{{else}}Share information in chat{{/if}}">{{c.rollLabel}}</button>
            <button type="button" class="brp-ui2-roll-action" data-action="rollChar" data-char="{{c.key}}" aria-label="Roll {{c.rollLabel}} ({{c.short}} × 5)">{{c.rollPct}}%</button>
          </div>
        </div>
      {{/each}}
    </div>
